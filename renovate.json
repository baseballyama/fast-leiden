{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":maintainLockFilesWeekly",
    "schedule:earlyMondays"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "engines.node is the support floor promised to users; raising it is a release decision, not a routine bump",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Group all non-major devDependency bumps into one PR",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devDependencies (non-major)"
    },
    {
      "description": "Native-toolchain deps are sensitive — never auto-merge",
      "matchPackageNames": ["node-addon-api", "node-gyp", "node-gyp-build", "prebuildify"],
      "automerge": false,
      "labels": ["dependencies", "native"]
    },
    {
      "description": "GitHub Actions: group all updates so the matrix moves together",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "ignoreDeps": [],
  "ignorePaths": ["vendor/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10
}
